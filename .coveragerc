[run]
source = core,scheduling,content,results,scoring,finance,competition,tournaments
omit =
    */migrations/*
    */tests.py
    */tests/*
    */tests_browser.py
    */__init__.py
    */apps.py
    # One-off import/generate utilities run by hand, not part of the app surface.
    */management/commands/*

[report]
show_missing = True
